<mxfile host="65bd71144e">
    <diagram id="fec-rx-03-happy" name="RX Diagram 3: Happy Path Block Assembly">
        <mxGraphModel dx="1594" dy="807" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;b&gt;RX Diagram 3: Happy Path Block Assembly (No Recovery)&lt;/b&gt;&lt;br&gt;Triggered when all dataSegsNeeded data segments have arrived before the GC timeout" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="280" y="15" width="680" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="trigger_title" value="&lt;b&gt;Trigger Condition&lt;/b&gt; (evaluated after each data packet receipt)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="60" y="75" width="430" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="trigger_box" value="&lt;font face=&quot;Courier New&quot;&gt;dataSegsNeeded = 32u − padFrames           // valid segment slots&lt;br&gt;dataMask       = (1u &lt;&lt; dataSegsNeeded) − 1  // LSB mask for valid bits&lt;br&gt;&lt;br&gt;if __builtin_popcount(dataReceived &amp; dataMask) == dataSegsNeeded:&lt;br&gt;    → ALL data segments received → assemble block now&lt;/font&gt;&lt;br&gt;&lt;br&gt;Note: parity segments may also have arrived, but they are not needed in the happy path." style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=#82b366;fillColor=#d5e8d4;fontSize=11;rounded=1;arcSize=5;" parent="1" vertex="1">
                    <mxGeometry x="60" y="102" width="760" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="trigger_box" target="loop_box" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="loop_title" value="&lt;b&gt;Scatter Loop&lt;/b&gt; (copy segments into event buffer using REHdr.bufferOffset)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="60" y="228" width="530" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="loop_box" value="&lt;font face=&quot;Courier New&quot;&gt;size_t maxUserData = colHeight − sizeof(REHdr)  // = 1400 B&lt;br&gt;&lt;br&gt;for (uint32_t i = 0; i &lt; dataSegsNeeded; ++i) {&lt;br&gt;    auto *segRe = reinterpret_cast&lt;REHdr*&gt;(&lt;br&gt;        segmentBuf.data() + i * colHeight);&lt;br&gt;&lt;br&gt;    size_t offset     = segRe-&gt;get_bufferOffset()  // = i * maxUserData&lt;br&gt;    size_t segDataLen = min(maxUserData, totalEventBytes − offset)&lt;br&gt;&lt;br&gt;    memcpy(item-&gt;event + offset,&lt;br&gt;           segmentBuf.data() + i * colHeight + sizeof(REHdr),&lt;br&gt;           segDataLen)&lt;br&gt;    item-&gt;curBytes += segDataLen&lt;br&gt;}&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=#82b366;fillColor=#d5e8d4;fontSize=11;rounded=1;arcSize=5;" parent="1" vertex="1">
                    <mxGeometry x="60" y="255" width="580" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="scatter_detail_title" value="&lt;b&gt;Scatter Illustration (one block of 4 segments, maxUserData=1400 B)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="700" y="75" width="440" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="seg0" value="segmentBuf row 0&lt;br&gt;[REHdr: offset=0][data 0..1399]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="700" y="105" width="320" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="seg1" value="segmentBuf row 1&lt;br&gt;[REHdr: offset=1400][data 1400..2799]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="700" y="145" width="320" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="seg2" value="segmentBuf row 2&lt;br&gt;[REHdr: offset=2800][data 2800..4199]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="700" y="185" width="320" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="seg_dots" value="⋮  (segments 3..dataSegsNeeded−2)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="700" y="225" width="260" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="seg_last" value="segmentBuf row N-1 (last)&lt;br&gt;[REHdr: offset=…][data (may be &lt; 1400 B)]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="700" y="250" width="320" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="evtbuf" value="event[N bytes] (EventQueueItem.event)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="700" y="350" width="580" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="evt_seg0" value="[0..1399]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="700" y="395" width="90" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="evt_seg1" value="[1400..2799]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="790" y="395" width="110" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="evt_seg2" value="[2800..4199]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="900" y="395" width="110" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="evt_dots" value="…" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1015" y="398" width="30" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="evt_last" value="[last segment]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1050" y="395" width="115" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="sc_arr0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;strokeColor=#82b366;" parent="1" source="seg0" target="evtbuf" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sc_arr1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;strokeColor=#82b366;" parent="1" source="seg1" target="evtbuf" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sc_arr2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;strokeColor=#82b366;" parent="1" source="seg2" target="evtbuf" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sc_arrlast" style="edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;strokeColor=#82b366;" parent="1" source="seg_last" target="evtbuf" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="loop_box" target="complete_box" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="complete_title" value="&lt;b&gt;Block Completion and Event Delivery&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="60" y="478" width="300" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="complete_box" value="&lt;font face=&quot;Courier New&quot;&gt;// Mark block as done&lt;br&gt;fecBlocksInProgress.erase(blockKey)&lt;br&gt;completedFecBlocks.insert(blockKey)&lt;br&gt;item-&gt;fecBlocksCompleted++&lt;br&gt;&lt;br&gt;// Check if all blocks for this event are complete&lt;br&gt;if (item-&gt;fecBlocksCompleted == item-&gt;fecBlocksExpected) {&lt;br&gt;    eventsInProgress.erase(eventKey)&lt;br&gt;    enqueue(item)   // → recvEvent() / getEvent()&lt;br&gt;    recvStats.eventSuccess++&lt;br&gt;}&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=#6c8ebf;fillColor=#dae8fc;fontSize=11;rounded=1;arcSize=5;" parent="1" vertex="1">
                    <mxGeometry x="60" y="505" width="500" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="notes_title" value="&lt;b&gt;Key Notes&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="60" y="695" width="100" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="notes_box" value="• REHdr.bufferOffset drives scatter: segment i of block b has offset = (b×32 + i) × maxUserData.&lt;br&gt;  This places each segment at the correct position in the N-byte event buffer.&lt;br&gt;&lt;br&gt;• The last segment of the last block may have segDataLen &lt; maxUserData&lt;br&gt;  (clamped by totalEventBytes − offset).&lt;br&gt;&lt;br&gt;• completedFecBlocks.insert() prevents any late-arriving duplicate from being placed again.&lt;br&gt;&lt;br&gt;• Multiple blocks for the same event are processed concurrently by different recv threads;&lt;br&gt;  evtsInProgressMutex protects the shared EventQueueItem during fecBlocksCompleted updates." style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=#666666;fillColor=#f5f5f5;fontSize=10;rounded=1;arcSize=5;" parent="1" vertex="1">
                    <mxGeometry x="60" y="722" width="740" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="evtbuf_label" value="&lt;b&gt;Event buffer layout after scatter (one block):&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="700" y="430" width="310" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="offset_note" value="bufferOffset values: 0, 1400, 2800, 4200, ... (multiples of maxUserData)&lt;br&gt;Last segment: offset = (dataSegsNeeded−1) × 1400, length may be &lt; 1400 B" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="700" y="450" width="480" height="35" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
