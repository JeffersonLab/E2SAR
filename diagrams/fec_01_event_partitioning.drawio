                <mxCell id="pb_total_label" value="↕ always 32 segments processed per block (zero-padded for RS)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="280" y="395" width="380" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="lastseg_title" value="&lt;b&gt;Last Segment of Event&lt;/b&gt; (may be shorter than maxUserData)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;" parent="1" vertex="1">
