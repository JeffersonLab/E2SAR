                <mxCell id="cwN_data" value="B0-3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#CCCCCC;fontSize=9;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="360" y="110" width="50" height="30" as="geometry"/>
