          <mxGeometry x="80" y="430" width="320" height="25" as="geometry" />
        </mxCell>

        <!-- REHdr fields table -->
        <mxCell id="reh_preamble" value="preamble[2]&lt;br&gt;(0x10, 0x00)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="465" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="reh_dataid" value="dataId&lt;br&gt;(2 B)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="180" y="465" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="reh_bufoff" value="bufferOffset&lt;br&gt;(4 B)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="260" y="465" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="reh_buflen" value="bufferLength&lt;br&gt;(4 B) = N" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="380" y="465" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="reh_evnum" value="eventNum&lt;br&gt;(8 B)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="500" y="465" width="140" height="40" as="geometry" />
        </mxCell>

        <mxCell id="rehdr_note" value="&lt;font face=&quot;Courier New&quot;&gt;bufferOffset = seg_index × maxUserData&lt;/font&gt; (byte offset into event)&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;bufferLength = N&lt;/font&gt; (total event size, same in every segment)&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;eventNum&lt;/font&gt; = event sequence number (same in every segment)" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="515" width="420" height="50" as="geometry" />
        </mxCell>

        <!-- ============================================================ -->
        <!-- Key insight: memset + placement new -->
        <!-- ============================================================ -->
        <mxCell id="impl_title" value="&lt;b&gt;Implementation Notes&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="580" width="160" height="25" as="geometry" />
        </mxCell>
        <mxCell id="impl_notes" value="1. &lt;font face=&quot;Courier New&quot;&gt;memset(segmentBuf, 0, 45440)&lt;/font&gt; — zero entire buffer (ensures padding is 0)&lt;br&gt;2. For each real segment i:&lt;br&gt;   • &lt;font face=&quot;Courier New&quot;&gt;dst = segmentBuf + i × colHeight&lt;/font&gt;&lt;br&gt;   • Placement-new REHdr at dst, set fields&lt;br&gt;   • &lt;font face=&quot;Courier New&quot;&gt;memcpy(dst + 20, event + dataOffset, segDataLen)&lt;/font&gt;&lt;br&gt;3. Pad frame rows remain zeroed (never written)&lt;br&gt;&lt;br&gt;&lt;b&gt;Critical:&lt;/b&gt; The REHdr is part of the FEC-protected data.&lt;br&gt;Loss of a data segment means loss of both the header and user payload;&lt;br&gt;RS parity protects both." style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=#666666;fillColor=#f5f5f5;fontSize=10;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="610" width="520" height="155" as="geometry" />
        </mxCell>

        <!-- ============================================================ -->
        <!-- Visual: column grouping for interleave (preview of next diagram) -->
        <!-- ============================================================ -->
        <mxCell id="colgroup_title" value="&lt;b&gt;Segment Indexing for Interleave (preview)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="430" width="290" height="25" as="geometry" />
        </mxCell>
        <mxCell id="colgroup" value="32 rows = 8 columns × 4 segs/column&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;Column 0: rows  0, 1, 2, 3   → symbol 0&lt;br&gt;Column 1: rows  4, 5, 6, 7   → symbol 1&lt;br&gt;Column 2: rows  8, 9,10,11   → symbol 2&lt;br&gt;Column 3: rows 12,13,14,15   → symbol 3&lt;br&gt;Column 4: rows 16,17,18,19   → symbol 4&lt;br&gt;Column 5: rows 20,21,22,23   → symbol 5&lt;br&gt;Column 6: rows 24,25,26,27   → symbol 6&lt;br&gt;Column 7: rows 28,29,30,31   → symbol 7&lt;/font&gt;&lt;br&gt;&lt;br&gt;Within each column, 4 rows provide&lt;br&gt;bits 3 (MSB), 2, 1, 0 (LSB) of&lt;br&gt;that column's GF(16) symbol." style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=#666666;fillColor=#f5f5f5;fontSize=10;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="460" width="290" height="240" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
