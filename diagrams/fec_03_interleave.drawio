                </mxCell>
                <mxCell id="cwdots" value="..." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="290" y="668" width="30" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="cw7" value="CW 7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="320" y="665" width="80" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="cwdots2" value="..." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="405" y="668" width="30" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="cwlast" value="CW 11359" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="430" y="665" width="80" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="byte_cw_note" value="byte_idx 0 of all 32 segs → CW 0..7 (8 words per byte)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="50" y="698" width="310" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="cwdetail_title" value="&lt;b&gt;Single Codeword (5 bytes = 10 GF(16) symbols)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="740" width="340" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="cwb0" value="Byte 0&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;[S0|S1]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="40" y="775" width="120" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="cwb1" value="Byte 1&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;[S2|S3]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="160" y="775" width="120" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="cwb2" value="Byte 2&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;[S4|S5]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="280" y="775" width="120" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="cwb3" value="Byte 3&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;[S6|S7]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="400" y="775" width="120" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="cwb4" value="Byte 4&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;[P0|P1]&lt;/font&gt;&lt;br&gt;= 0x00" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;verticalAlign=middle;align=center;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="520" y="775" width="120" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="cwb_note" value="S0–S7: 4-bit data symbols (from segments)     P0,P1: parity (zeroed here, filled by RS encode)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="825" width="570" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="mapping_title" value="&lt;b&gt;Mapping for Codeword W&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="700" y="70" width="180" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="mapping_detail" value="&lt;font face=&quot;Courier New&quot;&gt;byte_idx  = W / 8&lt;br&gt;bit_shift = 7 − (W % 8)&lt;/font&gt;&lt;br&gt;&lt;br&gt;For each symbol s (0..7):&lt;br&gt;  Extract 1 bit from each of 4 segments in column s&lt;br&gt;  at position &lt;font face=&quot;Courier New&quot;&gt;[seg × colHeight + byte_idx]&lt;/font&gt;, shifted by &lt;font face=&quot;Courier New&quot;&gt;bit_shift&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;nibble_s = (bit from seg s×4+0) &lt;&lt; 3   ← MSB&lt;br&gt;         | (bit from seg s×4+1) &lt;&lt; 2&lt;br&gt;         | (bit from seg s×4+2) &lt;&lt; 1&lt;br&gt;         | (bit from seg s×4+3) &lt;&lt; 0   ← LSB&lt;/font&gt;&lt;br&gt;&lt;br&gt;Pack nibble pairs into bytes:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;cw[0] = (nibble_0 &lt;&lt; 4) | nibble_1&lt;br&gt;cw[1] = (nibble_2 &lt;&lt; 4) | nibble_3&lt;br&gt;cw[2] = (nibble_4 &lt;&lt; 4) | nibble_5&lt;br&gt;cw[3] = (nibble_6 &lt;&lt; 4) | nibble_7&lt;br&gt;cw[4] = 0x00&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=#666666;fillColor=#f5f5f5;fontSize=10;rounded=1;arcSize=3;" parent="1" vertex="1">
                    <mxGeometry x="700" y="100" width="360" height="265" as="geometry"/>
                </mxCell>
                <mxCell id="example_title" value="&lt;b&gt;Example: Word W=0 (byte_idx=0, bit_shift=7)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="700" y="390" width="310" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="example_box" value="Extract bit 7 of byte 0 from all 32 segments:&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;Seg 0[0] bit 7 ─┐&lt;br&gt;Seg 1[0] bit 7 ─┤ → nibble for symbol 0&lt;br&gt;Seg 2[0] bit 7 ─┤   = {b3, b2, b1, b0}&lt;br&gt;Seg 3[0] bit 7 ─┘&lt;br&gt;&lt;br&gt;Seg 4[0] bit 7 ─┐&lt;br&gt;Seg 5[0] bit 7 ─┤ → nibble for symbol 1&lt;br&gt;Seg 6[0] bit 7 ─┤&lt;br&gt;Seg 7[0] bit 7 ─┘&lt;br&gt;    ⋮&lt;br&gt;Seg28[0] bit 7 ─┐&lt;br&gt;Seg29[0] bit 7 ─┤ → nibble for symbol 7&lt;br&gt;Seg30[0] bit 7 ─┤&lt;br&gt;Seg31[0] bit 7 ─┘&lt;/font&gt;&lt;br&gt;&lt;br&gt;Result: CW[0] = 5 bytes encoding 8 nibbles" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=#b85450;fillColor=#f8cecc;fontSize=10;rounded=1;arcSize=4;" parent="1" vertex="1">
                    <mxGeometry x="700" y="415" width="310" height="270" as="geometry"/>
                </mxCell>
                <mxCell id="mem_title" value="&lt;b&gt;Memory Layout Relationship&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="700" y="710" width="200" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="mem_note" value="&lt;font face=&quot;Courier New&quot;&gt;num_words = colHeight × 8 = 1420 × 8 = 11,360&lt;br&gt;&lt;br&gt;segmentBuf size  = 32 × 1420     = 45,440 B&lt;br&gt;codewordBuf size = 11,360 × 5    = 56,800 B&lt;br&gt;&lt;br&gt;Ratio: codewordBuf / segmentBuf ≈ 1.25×&lt;/font&gt;&lt;br&gt;(25% expansion from parity byte in each codeword)" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=#666666;fillColor=#f5f5f5;fontSize=10;rounded=1;arcSize=7;" parent="1" vertex="1">
                    <mxGeometry x="700" y="735" width="340" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="bitorder_title" value="&lt;b&gt;Bit Ordering (MSB-first)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="870" width="170" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="bitorder" value="Within each segment byte, bits are numbered MSB-first:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;  Bit 7 of byte 0 → word 0&lt;br&gt;  Bit 6 of byte 0 → word 1&lt;br&gt;  Bit 5 of byte 0 → word 2&lt;br&gt;  ...&lt;br&gt;  Bit 0 of byte 0 → word 7&lt;br&gt;  Bit 7 of byte 1 → word 8&lt;br&gt;  ...&lt;br&gt;  Bit 0 of byte 1419 → word 11,359&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=#666666;fillColor=#f5f5f5;fontSize=10;rounded=1;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="895" width="340" height="150" as="geometry"/>
                </mxCell>
