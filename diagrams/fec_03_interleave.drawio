                </mxCell>
                <mxCell id="transform_label" value="&lt;b&gt;interleave()&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="350" y="570" width="100" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="cw_title" value="&lt;b&gt;codewordBuf&lt;/b&gt; (output)&lt;br&gt;11,360 codewords × 5 bytes = 56,800 bytes" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="100" y="620" width="280" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="cw0" value="CW 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;verticalAlign=middle;align=center;" parent="1" vertex="1">
