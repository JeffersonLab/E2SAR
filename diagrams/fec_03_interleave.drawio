<mxfile host="65bd71144e">
    <diagram id="fec-interleave" name="Interleave: Segments to Codewords">
        <mxGraphModel dx="1275" dy="646" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;b&gt;Diagram 3: Interleave — Segment Buffer → Codeword Buffer&lt;/b&gt;&lt;br&gt;Bit-level transposition: 32 segments × colHeight bytes → 11,360 codewords × 5 bytes" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="350" y="15" width="560" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="seg_title" value="&lt;b&gt;segmentBuf&lt;/b&gt; (input)&lt;br&gt;32 rows × 1420 bytes" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="150" y="40" width="160" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="bit_labels" value="Within each column group of 4 segs:&lt;br&gt;  seg c×4+0 → bit 3 (MSB) of symbol c&lt;br&gt;  seg c×4+1 → bit 2&lt;br&gt;  seg c×4+2 → bit 1&lt;br&gt;  seg c×4+3 → bit 0 (LSB) of symbol c" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontFamily=Courier New;" parent="1" vertex="1">
                    <mxGeometry x="40" y="455" width="320" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="byte_idx_note" value="← 1420 bytes (colHeight) →&lt;br&gt;byte 0 ... byte 1419&lt;br&gt;Each byte has 8 bits (MSB-first: bit 7 → word 0)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="100" y="90" width="280" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="transform_arrow" value="" style="shape=flexArrow;endArrow=classic;html=1;fillColor=#f8cecc;strokeColor=#b85450;width=20;endSize=8;startSize=0;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="310" y="550" as="sourcePoint"/>
