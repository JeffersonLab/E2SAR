                <mxCell id="title" value="&lt;b&gt;Diagram 4: RS(10,8) Encoding over GF(2⁴)&lt;/b&gt;&lt;br&gt;Fills byte 4 (parity nibbles P0, P1) of each codeword independently" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="370" y="20" width="440" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="input_title" value="&lt;b&gt;Input: One Codeword (before RS)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="80" y="80" width="230" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="in_b0" value="Byte 0&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;[S0|S1]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="80" y="110" width="120" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="in_b1" value="Byte 1&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;[S2|S3]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="200" y="110" width="120" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="in_b2" value="Byte 2&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;[S4|S5]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="320" y="110" width="120" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="in_b3" value="Byte 3&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;[S6|S7]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="440" y="110" width="120" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="in_b4" value="Byte 4&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;[0x00]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;verticalAlign=middle;align=center;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="560" y="110" width="120" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="rs_arrow_in" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="in_b0" target="rs_box" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="140" y="175"/>
                            <mxPoint x="380" y="175"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="rs_box" value="&lt;b&gt;RS(10,8) Encoder&lt;/b&gt;&lt;br&gt;&lt;br&gt;8 data symbols (S0–S7) → 2 parity symbols (P0, P1)&lt;br&gt;over GF(16) = GF(2⁴)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="200" y="195" width="360" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="rs_arrow_out" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="rs_box" target="out_b4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="output_title" value="&lt;b&gt;Output: One Codeword (after RS)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="80" y="285" width="240" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="out_b0" value="Byte 0&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;[S0|S1]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="80" y="315" width="120" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="out_b1" value="Byte 1&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;[S2|S3]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="200" y="315" width="120" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="out_b2" value="Byte 2&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;[S4|S5]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="320" y="315" width="120" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="out_b3" value="Byte 3&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;[S6|S7]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="440" y="315" width="120" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="out_b4" value="Byte 4&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;[P0|P1]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=middle;align=center;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="560" y="315" width="120" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="unchanged_note" value="← unchanged →" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="250" y="363" width="100" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="computed_note" value="← computed" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;fontStyle=3;fontColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="580" y="363" width="75" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="gf_title" value="&lt;b&gt;GF(16) = GF(2⁴) Field&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="80" y="410" width="165" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="gf_box" value="&lt;b&gt;Irreducible polynomial:&lt;/b&gt; p(x) = x⁴ + x + 1&lt;br&gt;&lt;b&gt;Field elements:&lt;/b&gt; 0, 1, α, α², ..., α¹⁴ (where α⁴ = α + 1)&lt;br&gt;&lt;b&gt;Order:&lt;/b&gt; 15 (multiplicative group)&lt;br&gt;&lt;br&gt;&lt;b&gt;Operations:&lt;/b&gt;&lt;br&gt;  Addition: a + b = a ⊕ b (XOR, characteristic 2)&lt;br&gt;  Multiplication: a × b = α^((log(a) + log(b)) mod 15)  for a,b ≠ 0&lt;br&gt;&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Pre-computed lookup tables&lt;br&gt;  &lt;font face=&quot;Courier New&quot;&gt;gf_exp[16]&lt;/font&gt;: exponent → field element&lt;br&gt;  &lt;font face=&quot;Courier New&quot;&gt;gf_log[16]&lt;/font&gt;: field element → exponent" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=#666666;fillColor=#f5f5f5;fontSize=10;rounded=1;arcSize=4;" parent="1" vertex="1">
                    <mxGeometry x="80" y="440" width="400" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="enc_title" value="&lt;b&gt;Encoding Computation&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="80" y="640" width="170" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="enc_box" value="For each codeword, compute parity from data symbols:&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;P0 = Σ (G[0][j] × S[j])  for j = 0..7   (over GF(16))&lt;br&gt;P1 = Σ (G[1][j] × S[j])  for j = 0..7   (over GF(16))&lt;/font&gt;&lt;br&gt;&lt;br&gt;Where G is the 2×8 parity sub-matrix of the generator,&lt;br&gt;pre-converted to exponent form for fast multiply:&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;G[0] exponents: [11, 5, 11, 14, 10, 0, 12, 5]&lt;br&gt;G[1] exponents: [ 8, 14,  2, 13,  3, 0,  8, 3]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Result: &lt;font face=&quot;Courier New&quot;&gt;cw[4] = (P0 &lt;&lt; 4) | P1&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=#b85450;fillColor=#f8cecc;fontSize=10;rounded=1;arcSize=5;" parent="1" vertex="1">
                    <mxGeometry x="80" y="670" width="420" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="props_title" value="&lt;b&gt;RS(10,8) Code Properties&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="750" y="80" width="200" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="props_box" value="&lt;b&gt;Parameters:&lt;/b&gt;&lt;br&gt;  n = 10 (codeword length in symbols)&lt;br&gt;  k = 8  (data symbols)&lt;br&gt;  t = 1  (error-correcting capability)&lt;br&gt;  d = 3  (minimum distance = n−k+1)&lt;br&gt;&lt;br&gt;&lt;b&gt;Capabilities:&lt;/b&gt;&lt;br&gt;  • Correct 1 symbol error, OR&lt;br&gt;  • Detect 2 symbol errors, OR&lt;br&gt;  • Recover from 2 erasures (known positions)&lt;br&gt;&lt;br&gt;&lt;b&gt;In context of segments:&lt;/b&gt;&lt;br&gt;  Each &quot;symbol&quot; error = loss of 4 segments&lt;br&gt;  (the 4 segments that contribute one bit&lt;br&gt;   each to that symbol&#39;s nibble)&lt;br&gt;&lt;br&gt;  Can recover from loss of up to 2 symbols&lt;br&gt;  = up to 8 segments lost (erasure decoding)" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=#666666;fillColor=#f5f5f5;fontSize=10;rounded=1;arcSize=3;" parent="1" vertex="1">
                    <mxGeometry x="750" y="110" width="310" height="290" as="geometry"/>
                </mxCell>
                <mxCell id="scale_title" value="&lt;b&gt;Scale&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="750" y="420" width="50" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="scale_box" value="Applied independently to each of &lt;b&gt;11,360&lt;/b&gt; codewords per block.&lt;br&gt;&lt;br&gt;Each codeword is 5 bytes → encoding is a&lt;br&gt;very small operation (8 multiply-accumulates over GF(16)).&lt;br&gt;&lt;br&gt;Total work per block:&lt;br&gt;  11,360 × 16 GF multiplications = 181,760 GF muls&lt;br&gt;&lt;br&gt;NEON/AVX implementations batch multiple codewords&lt;br&gt;in SIMD registers for throughput." style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=#666666;fillColor=#f5f5f5;fontSize=10;rounded=1;arcSize=5;" parent="1" vertex="1">
                    <mxGeometry x="750" y="450" width="370" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="systematic_note" value="&lt;b&gt;Note:&lt;/b&gt; This is a &lt;i&gt;systematic&lt;/i&gt; code — data symbols S0–S7 appear&lt;br&gt;unchanged in the codeword. Only the parity (byte 4) is computed.&lt;br&gt;The original segment data is transmitted verbatim; parity segments&lt;br&gt;are sent separately." style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=#d6b656;fillColor=#fff2cc;fontSize=10;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="750" y="630" width="380" height="70" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>